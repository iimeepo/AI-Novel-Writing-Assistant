# AI-Novel 生产部署环境变量模板
# 用法：复制为 infra/.env 后填写。docker compose 会读取本文件，
#       既作为容器环境变量，也用于 docker-compose.yml 里的 ${...} 插值。
#
# 注意：以下变量已由 docker-compose.yml 的 environment 自动注入，无需在此填写
#   （即使写了也会被 environment 覆盖）：
#   AI_NOVEL_DATABASE_MODE, DATABASE_URL, NODE_ENV, PORT, HOST,
#   QDRANT_URL, IMAGE_STORAGE_ROOT

# ---------------------------------------------------------------------------
# 数据库：当前生产采用 SQLite-in-Docker（方案 B）。
# 数据文件放在名为 db_storage 的 Docker 卷内（容器路径 /app/storage/db/ai_novel.db），
# AI_NOVEL_DATABASE_MODE 与 DATABASE_URL 由 docker-compose.yml 注入，这里无需配置。
# 下面的 Postgres 凭证在 SQLite 模式下不再使用，保留注释备查（若日后改用 PG 再启用）。
# ---------------------------------------------------------------------------
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change_me_strong_password
# POSTGRES_DB=ai_novel

# ---------------------------------------------------------------------------
# 访问控制
# 采用 web 容器 nginx 同域反代 /api，浏览器访问的是同一个域名，通常无需跨域。
# 若你另外用独立域名直连 api，请把该域名加入 CORS_ORIGIN。
# ---------------------------------------------------------------------------
ALLOW_LAN=false
CORS_ORIGIN=

# 每本小说保留的自动版本快照数量；手动保存的快照不受这个数量限制。
NOVEL_SNAPSHOT_RETENTION_COUNT=10
# 公网部署建议收窄请求体上限（如 5mb）以降低 DoS 面。
API_JSON_LIMIT=10mb

# 导演 V1/V2 选择；设为 false 可关闭 V2。
DIRECTOR_NEXT_ENABLED=true

# ---------------------------------------------------------------------------
# 图片资产存储：默认本地文件存储（compose 已挂载 api_storage 卷到该路径）。
# 仅在需要对象存储时切换为 minio/s3 并补全下面参数。
# ---------------------------------------------------------------------------
# IMAGE_STORAGE_DRIVER=local
# IMAGE_STORAGE_DRIVER=minio
# IMAGE_STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# IMAGE_STORAGE_S3_REGION=us-east-1
# IMAGE_STORAGE_S3_BUCKET=ai-novel-images
# IMAGE_STORAGE_S3_ACCESS_KEY_ID=
# IMAGE_STORAGE_S3_SECRET_ACCESS_KEY=
# IMAGE_STORAGE_S3_FORCE_PATH_STYLE=true
# IMAGE_GENERATION_HTTP_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# 模型 Provider：主用 DeepSeek 生成正文。
# ⚠️ 必填：DeepSeek 的 API Key（部署前或启动后的设置页填写其一，二者取一即可）。
# 具体的模型/Base URL 也可在启动后的设置页覆盖，这里作为首次启动兜底。
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ⚠️ 必填：填入 DeepSeek API Key 后正文创作才能工作。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ⚠️ 必填：用于知识库向量检索（bge-m3 长期免费）。注册硅基流动送额度，拿到 Key 填入。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
SILICONFLOW_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# 与 EMBEDDING_MODEL 保持一致（EMBEDDING_MODEL 优先级更高）。
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-32k

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5-air

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# RAG / 向量检索：使用硅基流动 BAAI/bge-m3（长期免费、1024 维）。
# 正文仍用 DeepSeek，向量走 SiliconFlow，两者互不影响。
# 前置：上面 SILICONFLOW_API_KEY 必须已填。
# QDRANT_URL 由 compose 注入为 http://qdrant:6333；本地 Qdrant 无需 API Key，QDRANT_API_KEY 留空。
# 注：bge-m3 为 1024 维，以后若更换 embedding 模型需重建集合并重新索引。
# ---------------------------------------------------------------------------
RAG_ENABLED=true
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VERSION=1
EMBEDDING_BATCH_SIZE=64
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_novel_chunks_v1
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_VECTOR_CANDIDATES=40
RAG_KEYWORD_CANDIDATES=40
RAG_FINAL_TOP_K=8

# ---------------------------------------------------------------------------
# 前端构建参数（无需在此设置）
# VITE_API_BASE_URL 由 docker-compose.yml 的 web build args 固定为 /api，
# 走 web 容器 nginx 的同域反代。
# ---------------------------------------------------------------------------
